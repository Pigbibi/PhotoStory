{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photostory",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "3847549", "simple": { "limit": 20, "period": 60 } },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": { "ALLOWED_GITHUB_USERS": "YOUR_GITHUB_USERNAME", "AI_CAPTION_LANGUAGE": "en", "AI_EDITOR_LANGUAGE": "en", "INSTAGRAM_CLIENT_ID": "", "INSTAGRAM_USERNAME": "", "INSTAGRAM_REDIRECT_URI": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photostory",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    },
  ],
  "observability": { "enabled": false },
}
