[Unit]
Description=PhotoStory isolated AI invocation

[Service]
Type=oneshot
User=photostory-ai
Group=photostory-bridge
ExecStart=/usr/bin/python3 /opt/photostory/app/scripts/run_isolated_ai.py
WorkingDirectory=/var/lib/photostory-ai
Environment=PHOTOSTORY_AI_MODE=codex-cli
Environment=HOME=/var/lib/photostory-ai
Environment=CODEX_HOME=/var/lib/photostory-ai/codex
UMask=0027
TimeoutStartSec=640
MemoryMax=1G
TasksMax=64
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=/opt:ro /var:ro /run:ro /etc:ro
BindReadOnlyPaths=/opt/photostory/app
BindReadOnlyPaths=-/opt/codex-gateway/bin/codex-gateway -/opt/codex-gateway/scripts/codex_gateway.py
BindReadOnlyPaths=/var/lib/photostory-bridge/input
BindReadOnlyPaths=/etc/ssl/certs /etc/resolv.conf /etc/hosts /etc/nsswitch.conf /etc/passwd /etc/group
BindReadOnlyPaths=-/etc/ld.so.cache -/etc/localtime
BindPaths=/var/lib/photostory-ai /var/lib/photostory-bridge/output
StandardOutput=journal
StandardError=null
